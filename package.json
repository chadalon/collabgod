{
  "name": "collabgod",
  "version": "0.1.0",
  "private": true,
  "description": "CollabGod: a DAW where two producers edit the same session at the same time",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ts": "node scripts/build.mjs --only ts",
    "build:app": "node scripts/build.mjs --only app",
    "test": "node scripts/test.mjs",
    "test:ts": "node scripts/test.mjs --only ts",
    "test:app": "node scripts/test.mjs --only app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:spikes": "node scripts/check-no-spike-imports.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fast-check": "4.11.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
