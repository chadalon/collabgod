{
  "description": "Reset removes every track the model made, and only those",
  "commands": [
    { "op": "track.add", "id": "t1", "after": null },
    { "op": "clip.add", "id": "a", "trackId": "t1", "start": 0, "length": 1, "sampleHash": "hash-a", "file": "${samples}/a.wav" },
    { "op": "reset" },
    { "op": "track.add", "id": "t3", "after": null }
  ],
  "readback": {
    "tracks": [ { "id": "t3", "clips": [] } ]
  }
}
