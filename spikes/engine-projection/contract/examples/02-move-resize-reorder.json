{
  "description": "Move a clip to another track and time, shorten another, put the second track first",
  "commands": [
    { "op": "track.add", "id": "t1", "after": null },
    { "op": "track.add", "id": "t2", "after": "t1" },
    { "op": "clip.add", "id": "a", "trackId": "t1", "start": 1, "length": 1, "sampleHash": "hash-a", "file": "${samples}/a.wav" },
    { "op": "clip.add", "id": "b", "trackId": "t2", "start": 2, "length": 0.5, "sampleHash": "hash-b", "file": "${samples}/b.wav" },
    { "op": "clip.set", "id": "a", "trackId": "t2", "start": 3 },
    { "op": "clip.set", "id": "b", "length": 0.25 },
    { "op": "track.move", "id": "t2", "after": null }
  ],
  "readback": {
    "tracks": [
      { "id": "t2", "clips": [
        { "id": "a", "start": 3, "length": 1, "offset": 0, "sampleHash": "hash-a", "file": "${samples}/a.wav" },
        { "id": "b", "start": 2, "length": 0.25, "offset": 0, "sampleHash": "hash-b", "file": "${samples}/b.wav" }
      ] },
      { "id": "t1", "clips": [] }
    ]
  }
}
