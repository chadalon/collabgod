# Runs the scanner over the fake plugins and checks the inventory. Spike code (issue #14).
#
#   cmake -DSCANNER=<plugin_scan> -DFIXTURES=<folder> -DOUT=<json> -DGOOD_CID=<hex>
#         -P CheckInventory.cmake

foreach(var SCANNER FIXTURES OUT GOOD_CID)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "${var} is required")
    endif()
endforeach()

file(REMOVE ${OUT})

# Three seconds per plugin: the hanging one must be stopped, the others need far less.
string(TIMESTAMP started "%s")
execute_process(
    COMMAND ${SCANNER} scan --timeout 3 --label fixtures --out ${OUT} ${FIXTURES}
    RESULT_VARIABLE rc
    ERROR_VARIABLE progress)
string(TIMESTAMP finished "%s")
message("${progress}")
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "scan exited with ${rc}")
endif()

file(READ ${OUT} inv)

set(failures 0)
macro(expect what actual expected)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(SEND_ERROR "${what}: expected '${expected}', got '${actual}'")
        math(EXPR failures "${failures} + 1")
    else()
        message(STATUS "ok: ${what} = ${actual}")
    endif()
endmacro()

# Reads a field, giving NOTFOUND rather than failing when it is absent.
function(get out)
    string(JSON value ERROR_VARIABLE err GET "${inv}" ${ARGN})
    if(err)
        set(value "NOTFOUND")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

get(schema schema)
expect("schema" "${schema}" "collabgod.plugin-inventory/1")
get(label label)
expect("label" "${label}" "fixtures")
get(os machine os)
if(NOT os MATCHES "^(windows|macos|linux)$")
    message(SEND_ERROR "machine.os is '${os}'")
    math(EXPR failures "${failures} + 1")
endif()

# Index the bundles by path.
string(JSON count LENGTH "${inv}" bundles)
expect("bundles found" "${count}" "9")
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON p GET "${inv}" bundles ${i} path)
    string(MAKE_C_IDENTIFIER "${p}" key)
    set(idx_${key} ${i})
    if(IS_ABSOLUTE "${p}")
        message(SEND_ERROR "bundle path is absolute: ${p}")
        math(EXPR failures "${failures} + 1")
    endif()
endforeach()

function(bundle out name)
    string(MAKE_C_IDENTIFIER "${name}" key)
    if(NOT DEFINED idx_${key})
        message(SEND_ERROR "bundle ${name} not in the inventory")
        set(${out} "NOTFOUND" PARENT_SCOPE)
        return()
    endif()
    set(${out} ${idx_${key}} PARENT_SCOPE)
endfunction()

# --- The well-behaved plugin -------------------------------------------------
bundle(g good.vst3)
get(v bundles ${g} ending)
expect("good: ending" "${v}" "exited")
get(v bundles ${g} probe result)
expect("good: result" "${v}" "ok")
get(v bundles ${g} probe factoryInterface)
expect("good: factory interface" "${v}" "3")
get(v bundles ${g} probe classes 0 cid)
expect("good: canonical class ID" "${v}" "${GOOD_CID}")
get(v bundles ${g} probe classes 0 category)
expect("good: category" "${v}" "Audio Module Class")
get(v bundles ${g} probe classes 0 name)
expect("good: name" "${v}" "CollabGod Test Synth")
get(v bundles ${g} probe classes 0 vendor)
expect("good: vendor" "${v}" "CollabGod Tests")
get(v bundles ${g} probe classes 0 version)
expect("good: version" "${v}" "1.0.0")
get(v bundles ${g} probe classes 0 infoLevel)
expect("good: info level" "${v}" "unicode")
get(v bundles ${g} probe classes 1 category)
expect("good: second class" "${v}" "Component Controller Class")
get(v bundles ${g} probe factory vendor)
expect("good: factory vendor" "${v}" "CollabGod Tests")
get(v bundles ${g} moduleInfo)
if(NOT v MATCHES "\"CID\": \"${GOOD_CID}\"")
    message(SEND_ERROR "good: moduleInfo missing or without the class ID: ${v}")
    math(EXPR failures "${failures} + 1")
endif()
get(v bundles ${g} probe entryPoint)
if(os STREQUAL "windows")
    expect("good: entry point" "${v}" "InitDll")
elseif(os STREQUAL "macos")
    expect("good: entry point" "${v}" "bundleEntry")
    get(v bundles ${g} probe binaryVersion shortVersion)
    expect("good: Info.plist version" "${v}" "1.0.0")
else()
    expect("good: entry point" "${v}" "ModuleEntry")
endif()

bundle(n Vendor/Sub/nested.vst3)
get(v bundles ${n} probe classes 0 cid)
expect("nested: class ID" "${v}" "11111111222222223333333344444444")
get(v bundles ${n} probe classes 0 version)
expect("nested: version" "${v}" "2.1")

# --- Older factory interface: no per-class vendor or version -------------------
bundle(o factory-v1.vst3)
get(v bundles ${o} probe result)
expect("factory-v1: result" "${v}" "ok")
get(v bundles ${o} probe factoryInterface)
expect("factory-v1: factory interface" "${v}" "1")
get(v bundles ${o} probe classes 0 infoLevel)
expect("factory-v1: info level" "${v}" "v1")
get(v bundles ${o} probe classes 0 version)
expect("factory-v1: version" "${v}" "")
get(v bundles ${o} probe classes 0 cid)
expect("factory-v1: class ID" "${v}" "0BADF00D000000010000000200000003")

# --- Badly behaved plugins: each recorded, none fatal --------------------------
bundle(c crash-on-load.vst3)
get(v bundles ${c} ending)
expect("crash-on-load: ending" "${v}" "crashed")
get(v bundles ${c} probeWritten)
expect("crash-on-load: probe written" "${v}" "OFF")

bundle(h hang-on-load.vst3)
get(v bundles ${h} ending)
expect("hang-on-load: ending" "${v}" "timed-out")
get(v bundles ${h} probeWritten)
expect("hang-on-load: probe written" "${v}" "OFF")

bundle(u crash-on-unload.vst3)
get(v bundles ${u} ending)
expect("crash-on-unload: ending" "${v}" "crashed")
get(v bundles ${u} probeWritten)
expect("crash-on-unload: probe written" "${v}" "ON")
get(v bundles ${u} probe result)
expect("crash-on-unload: result" "${v}" "ok")
get(v bundles ${u} probe classes 0 name)
expect("crash-on-unload: name still read" "${v}" "Unload Crasher")

bundle(z null-factory.vst3)
get(v bundles ${z} probe result)
expect("null-factory: result" "${v}" "factory-null")

bundle(x no-export.vst3)
get(v bundles ${x} probe result)
expect("no-export: result" "${v}" "no-factory-export")

bundle(e empty.vst3)
get(v bundles ${e} probe result)
expect("empty: result" "${v}" "no-binary")

# The hang costs the 3 s limit; everything else together should be quick.
math(EXPR seconds "${finished} - ${started}")
message(STATUS "scan took about ${seconds} s")
if(seconds GREATER 30)
    message(SEND_ERROR "scan took ${seconds} s; the time limit is not working")
    math(EXPR failures "${failures} + 1")
endif()

if(failures GREATER 0)
    message(FATAL_ERROR "${failures} checks failed. Inventory: ${OUT}")
endif()
message(STATUS "All checks passed.")
